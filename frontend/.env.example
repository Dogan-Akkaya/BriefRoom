VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side ingestion only (NOT prefixed with VITE_) ---
# These are read by `npm run ingest` and the GitHub Actions ingest workflow.
# They must NEVER be exposed to the browser bundle, so do not add the VITE_
# prefix — Vite would otherwise inline them at build time.
# In CI, set each as a separate repository secret
# (Settings → Secrets and variables → Actions).

# Shared base URL across all ThreatVision products.
THREATVISION_BASE_URL=https://api.threatvision.example.com

# Per-product keys. Each ingestor only needs its own key — missing keys cause
# that ingestor to skip cleanly (the orchestrator still runs the others).
THREATVISION_RANSOMWARE_KEY=your-ransomware-key
THREATVISION_DARKWEB_KEY=your-darkweb-key
THREATVISION_THREAT_ACTORS_KEY=your-threat-actors-key

# Optional ingestion knobs (defaults shown):
#   INGEST_WINDOW_DAYS=30   # rolling window per ingestor
#   INGEST_PAGE_SIZE=100    # API page size hint (used where supported)
